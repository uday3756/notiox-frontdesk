# =============================================================================
# NotioX Front Desk — environment variables
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- App ---
# Public URL of this Front Desk app (local / preprod / prod)
VITE_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Primary host for the Front Desk console (no scheme)
APP_HOST=localhost:3000

# Comma-separated extra hosts allowed to serve the app (custom domains / white-label).
# Example: desk.example.com,coach.brand.com
# Owners configure DNS CNAME → your deployment; then add the hostname here (or via
# owners.custom_domain + runtime allow-list — see settings + hostAllowlist).
ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# NotioX client/student app (clients enter promo/referral codes there — do not change casually)
VITE_NOTIOX_CLIENT_URL=https://www.notiolive.com
NOTIOX_CLIENT_URL=https://www.notiolive.com

# --- Supabase ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Auth redirect (email confirm / magic link — must match Auth URL config)
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# --- Google OAuth — DEFERRED (do not enable until user asks) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Resend (later — keep placeholders; email UI simulates without this) ---
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Front Desk <noreply@your-verified-domain.com>
RESEND_TEST_TO_EMAIL=you@example.com

# --- Stripe (later — revenue UI stays placeholder without these) ---
# Use real keys from Stripe Dashboard; do not put sk_test_/pk_test_ placeholders in git.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_ID=your-stripe-price-id

# --- Session / cookies (generate a long random string for production) ---
SESSION_SECRET=replace-with-long-random-string
